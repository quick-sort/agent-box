ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_BASE_URL=https://llm.quicksort.info
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku
API_TIMEOUT_MS=3000000
ENABLE_TOOL_SEARCH=0
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Agent backends. AGENTS must be a JSON array.
AGENTS=["claude_code"]
DEFAULT_AGENT=claude_code
AGENT_PERMISSION_MODE=bypassPermissions

# Generic ACP driver
ACP_STARTUP_TIMEOUT=30
ACP_SHUTDOWN_TIMEOUT=5

# WeCom (企业微信) Bot WebSocket channel
# Run: uv run agent-box --wecom
#
# Multiple bots: set WECOM_BOTS to a JSON array (single line); each entry
# carries its own credentials/params. WECOM_BOTS takes precedence over the
# legacy single-bot fields below. Supported per-instance fields:
#   name, bot_id, secret, ws_url, scene, plug_version,
#   reconnect_interval, max_reconnect_attempts, max_auth_failure_attempts,
#   heartbeat_interval, request_timeout
# WECOM_BOTS=[{"name":"prod","bot_id":"...","secret":"...","ws_url":"wss://openws.work.weixin.qq.com"},{"name":"test","bot_id":"...","secret":"..."}]
WECOM_BOTS=

# Legacy single-bot credentials (used when WECOM_BOTS is empty)
WECOM_BOT_ID=
WECOM_SECRET=