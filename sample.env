ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_BASE_URL=https://llm.quicksort.info
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku
API_TIMEOUT_MS=3000000
ENABLE_TOOL_SEARCH=0
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Agent backends. AGENTS must be a JSON array.
AGENTS=["claude_code","kiro"]
DEFAULT_AGENT=claude_code
AGENT_PERMISSION_MODE=bypassPermissions

# Generic ACP driver
ACP_STARTUP_TIMEOUT=30
ACP_SHUTDOWN_TIMEOUT=5

# Kiro ACP provider
# Generate an API key in Kiro account settings for headless/container use.
KIRO_API_KEY=
KIRO_CLI_PATH=kiro-cli
KIRO_ACP_ENGINE=v2
# Optional Kiro custom agent name (from .kiro/agents or ~/.kiro/agents)
KIRO_AGENT=

# WeCom (企业微信) Bot WebSocket channel
# Run: uv run agent-box --wecom
WECOM_BOT_ID=
WECOM_SECRET=